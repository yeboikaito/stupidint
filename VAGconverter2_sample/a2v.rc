/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 296, 85
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About a2v"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "AIFF to VAG Converter Sample version 2.0.1",IDC_STATIC,40,10,236,8,SS_NOPREFIX
    LTEXT           "SCE CONFIDENTIAL\nCopyright (C) 2016 Sony Interactive Entertainment Inc. All Rights Reserved.\nCopyright 2009 Sony Corporation.",IDC_STATIC,40,25,255,27
    DEFPUSHBUTTON   "OK",IDOK,124,64,50,16,WS_GROUP
END

IDD_A2V_DIALOG DIALOGEX 0, 0, 228, 161
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "AIFF to VAG Converter sample version 2.0.1"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    CONTROL         IDB_A2V,IDC_STATIC,"Static",SS_BITMAP,8,8,211,60,WS_EX_STATICEDGE
    EDITTEXT        IDC_EDIT_SRC,8,84,180,12,ES_AUTOHSCROLL
    LTEXT           "Input File:",IDC_STATIC,8,76,34,8
    LTEXT           "Output File:",IDC_STATIC,8,103,39,8
    EDITTEXT        IDC_EDIT_DST,8,112,180,12,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_BUTTON_SRC,188,84,32,12
    PUSHBUTTON      "...",IDC_BUTTON_DST,188,112,32,12
    PUSHBUTTON      "Convert",IDC_BUTTON_CNV,84,136,60,16
END


